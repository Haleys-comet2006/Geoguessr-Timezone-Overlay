{
  "manifest_version": 3,
  "name": "GeoGuessr Timezone Overlay",
  "version": "1.2.0",
  "host_permissions": [
    "https://www.geoguessr.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.geoguessr.com/*"
      ],
      "js": [
        "timezone-lookup.js",
        "polygon-loader.js",
        "polygon-renderer.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "page.js",
        "combined-now.json",
        "vendor/tzf-wasm/tzf_wasm.js",
        "vendor/tzf-wasm/tzf_wasm_bg.wasm"
      ],
      "matches": [
        "https://www.geoguessr.com/*"
      ]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
